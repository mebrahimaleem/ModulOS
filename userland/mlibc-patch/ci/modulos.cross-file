[binaries]
c = 'clang-19'
cpp = 'clang++-19'
ar = 'llvm-ar-19'
ld = 'llvm-ld-19'
cpp_ld = 'llvm-ld-19'
strip = 'llvm-strip-19'

[host_machine]
system = 'modulos'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
sizeof_int = 4
sizeof_void* = 8

alignment_char = 1
alignment_void* = 8
alignment_double = 8
